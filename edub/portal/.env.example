# Copy to .env.local (chmod 600, owner edub). Never commit real values.
EDUB_DESIGN_DATABASE_URL=postgres://edub_design:CHANGE_ME@127.0.0.1:5432/edub_design
# HMAC secret for the per-file editor tokens (openssl rand -hex 32).
EDUB_DESIGN_TOKEN_SECRET=
# File holding the shared secret the Rust editor sends in X-OP-Internal-Auth
# (same file as OPENPENCIL_HUB_INTERNAL_AUTH_FILE in the PM2 ecosystem).
EDUB_DESIGN_HUB_INTERNAL_AUTH_FILE=/home/edub/.config/edub-design/hub-internal-auth
# Public origin; non-GET editor calls must come from it (CSRF).
EDUB_DESIGN_PUBLIC_ORIGIN=https://design.edub.fr
# Rust editor (loopback) and Authelia (loopback) addresses.
EDUB_DESIGN_EDITOR_URL=http://127.0.0.1:3100
EDUB_DESIGN_AUTHELIA_URL=http://127.0.0.1:9091
# Editor tenant store (OPENPENCIL_ONLINE_DATA_DIR of the editor).
EDUB_DESIGN_EDITOR_DATA_DIR=/home/edub/apps/edub-design/data/editor
# DEV ONLY (ignored when NODE_ENV=production): impersonate a user without Authelia.
# Format: username[:group1,group2]   e.g. patrick:design
# EDUB_DESIGN_DEV_USER=edub:design,admin
